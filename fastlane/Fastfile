def update_dart(new_version)
  path = Dir['../lib/**/qonversion_internal.dart'].first
  regex = /static const String sdkVersion = ".*";/
  result_value = "static const String sdkVersion = \"#{new_version}\";"

  update_file(path, regex, result_value)
end

def update_yaml(new_version)
  path = "../pubspec.yaml"
  regex = /version: .*/
  result_value = "version: #{new_version}"

  update_file(path, regex, result_value)
end

# The podspecs are consumed as path pods (their version is cosmetic, it shows up in Podfile.lock) — keep them in step.
def update_podspecs(new_version)
  ["../ios/qonversion_flutter.podspec", "../macos/qonversion_flutter.podspec"].each do |path|
    update_file_strict(path, /s\.version\s*=\s*'[^']*'/, "s.version          = '#{new_version}'")
  end
end

def update_file(path, regex, result_value)
  file = File.read(path)
  new_content = file.gsub(regex, result_value)
  File.open(path, 'w') { |line| line.puts new_content }
end

# If CHANGELOG.md starts with an "## Unreleased" section, the release turns it into the version's
# section; otherwise a placeholder section is inserted (legacy behaviour).
def update_changelog(new_version)
  path = "../CHANGELOG.md"
  file = File.read(path)
  if file.start_with?("## Unreleased\n")
    File.write(path, file.sub("## Unreleased\n", "## #{new_version}\n"))
    return
  end

  changelog_update = "\#\# #{new_version}\n* // Update changelog here\n\n"
  File.open(path, 'w') { |line| 
    line.puts changelog_update + file 
  }
end

def upgrade_sandwich_android(new_version)
  common_part = "implementation \"io.qonversion:sandwich:"
  update_file_strict("../android/build.gradle", /#{common_part}.*"/, "#{common_part}#{new_version}\"")
end

# The sandwich pin lives in two manifests per platform (podspec for CocoaPods, Package.swift for SwiftPM);
# they must always match.
def upgrade_sandwich_apple(platform, new_version)
  common_part = "s.dependency \"QonversionSandwich\", \""
  update_file_strict("../#{platform}/qonversion_flutter.podspec", /#{common_part}.*"/, "#{common_part}#{new_version}\"")
  update_file_strict("../#{platform}/qonversion_flutter/Package.swift", /sandwich-sdk.git", exact: ".*"\)/, "sandwich-sdk.git\", exact: \"#{new_version}\")")
end

# Every manifest the sandwich pin lives in, with the pattern that must match exactly once.
SANDWICH_PIN_FILES = {
  "../android/build.gradle" => /implementation "io.qonversion:sandwich:.*"/,
  "../ios/qonversion_flutter.podspec" => /s.dependency "QonversionSandwich", ".*"/,
  "../ios/qonversion_flutter/Package.swift" => /sandwich-sdk.git", exact: ".*"\)/,
  "../macos/qonversion_flutter.podspec" => /s.dependency "QonversionSandwich", ".*"/,
  "../macos/qonversion_flutter/Package.swift" => /sandwich-sdk.git", exact: ".*"\)/,
}

def assert_sandwich_pins_updatable
  SANDWICH_PIN_FILES.each do |path, regex|
    matches = File.read(path).scan(regex).length
    UI.user_error!("#{path}: expected exactly one match for #{regex.inspect}, found #{matches}") unless matches == 1
  end
end

# Like update_file, but fails loudly unless the pattern matches exactly once —
# a silent no-op would let the podspec and Package.swift pins drift apart.
def update_file_strict(path, regex, result_value)
  file = File.read(path)
  matches = file.scan(regex).length
  UI.user_error!("#{path}: expected exactly one match for #{regex.inspect}, found #{matches}") unless matches == 1
  File.write(path, file.sub(regex, result_value))
end


def get_tag
  tag = last_git_tag()
  puts tag
  result_tag = tag.scan(%r{\d{1,2}.\d{1,2}.\d{1,3}}).first
  return result_tag
end

def calculate_patch_version(tag)
  major, minor, patch = parse_versions(tag)
  new_patch_version = patch.to_i.next.to_s
  new_version = major + "." + minor + "." + new_patch_version

  return new_version
end

def parse_versions(tag)
  split_version_array = tag.split(".", 3)

  if split_version_array.length == 3
    major = split_version_array[0]
    minor = split_version_array[1]
    patch = split_version_array[2]

    return major, minor, patch
  end
end

lane :bump do |options|
  new_version = options[:version]
  UI.user_error!("Pass version:x.y.z") unless new_version.to_s.match?(/\A\d+\.\d+\.\d+\z/)

  update_dart(new_version)
  update_yaml(new_version)
  update_podspecs(new_version)
  update_changelog(new_version)
end

lane :upgrade_sandwich do |options|
  new_version = options[:version]
  UI.user_error!("Pass version:x.y.z") unless new_version.to_s.match?(/\A\d+\.\d+\.\d+\z/)
  # Check every manifest first so a broken pattern cannot leave the tree half-bumped.
  assert_sandwich_pins_updatable

  upgrade_sandwich_android(new_version)
  upgrade_sandwich_apple("ios", new_version)
  upgrade_sandwich_apple("macos", new_version)
end

lane :provide_next_patch_version do
  tag = get_tag
  new_version = calculate_patch_version(tag)
  sh("echo version=#{new_version} >> \"$GITHUB_ENV\"")
end
